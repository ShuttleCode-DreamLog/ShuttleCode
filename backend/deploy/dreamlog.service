[Unit]
After=network.target
StartLimitIntervalSec=0

[Service]
Type=simple
Restart=on-failure
RestartSec=1
User=ubuntu
Group=www-data
WorkingDirectory=/home/ubuntu/dreamlog/backend
SecureBits=keep-caps
CapabilityBoundingSet=CAP_NET_BIND_SERVICE
AmbientCapabilities=CAP_NET_BIND_SERVICE
EnvironmentFile=/home/ubuntu/.env.sys
ExecStart=/home/ubuntu/dreamlog/backend/.venv/bin/python3 -u dreamlogd.py

[Install]
WantedBy=multi-user.target
